[Unit]
Description=VENTUNO Q: restart the MCU USB controller once at boot
# Binding the USB gadget on usb_1 at boot leaves usb_2 unable to detect the
# MCU: restart it after the gadget is up (without a gadget the ordering is moot)
After=android-tools-adbd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ventuno-q-usb2-reset

[Install]
WantedBy=multi-user.target
