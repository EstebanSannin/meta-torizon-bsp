From 3ab3c83853eff1804a97972c7ead47a68d0a7b1e Mon Sep 17 00:00:00 2001
From: Stefano Viola <stefano.viola@toradex.com>
Date: Thu, 15 Oct 2026 18:23:30 +0200
Subject: [PATCH] PCI: qcom: Honour #iommu-cells when programming the BDF to
 SID table

qcom_pcie_config_sid_1_9_0() reads iommu-map as fixed 4-cell entries
<bdf phandle sid length>. The PCIe SMMU on monaco (QCS8300) and other
SoCs now has #iommu-cells = <2> and its iommu-map entries are 5 cells
<bdf phandle sid mask length>, which the OF core handles since commit
ccb2fd725d41 ("of: Respect #{iommu,msi}-cells in maps"). The driver
then programs a misaligned table: only the first entry is right and
every other BDF falls back to SID 0, so the DMA of devices behind a
PCIe switch hits the root port's context bank (Arduino VENTUNO Q:
QCA2066 Wi-Fi and TUSB7340 USB host fail, "Unhandled context fault ...
SID=0x0").

Read #iommu-cells from the SMMU node and use 3 + cells cells per entry,
accepting 1-cell entries for a 2-cell SMMU like of_map_id() does.

Upstream-Status: Pending
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Stefano Viola <stefano.viola@toradex.com>
---
 drivers/pci/controller/dwc/pcie-qcom.c | 63 ++++++++++++++++++--------
 1 file changed, 45 insertions(+), 18 deletions(-)

diff --git a/drivers/pci/controller/dwc/pcie-qcom.c b/drivers/pci/controller/dwc/pcie-qcom.c
index d62cf302de2b..71a5c71f5df2 100644
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -1119,37 +1119,62 @@ static void qcom_pcie_deinit_2_7_0(struct qcom_pcie *pcie)
 
 static int qcom_pcie_config_sid_1_9_0(struct qcom_pcie *pcie)
 {
-	/* iommu map structure */
-	struct {
-		u32 bdf;
-		u32 phandle;
-		u32 smmu_sid;
-		u32 smmu_sid_len;
-	} *map;
 	void __iomem *bdf_to_sid_base = pcie->parf + PARF_BDF_TO_SID_TABLE_N;
 	struct device *dev = pcie->pci->dev;
 	u8 qcom_pcie_crc8_table[CRC8_TABLE_SIZE];
-	int i, nr_map, size = 0;
+	int i, nr_cells, nr_map, entry_len, size = 0;
+	struct device_node *smmu;
+	u32 cells = 1;
 	u32 smmu_sid_base;
+	u32 *map;
 	u32 val;
 
 	of_get_property(dev->of_node, "iommu-map", &size);
 	if (!size)
 		return 0;
 
-	/* Enable BDF to SID translation by disabling bypass mode (default) */
-	val = readl(pcie->parf + PARF_BDF_TO_SID_CFG);
-	val &= ~BDF_TO_SID_BYPASS;
-	writel(val, pcie->parf + PARF_BDF_TO_SID_CFG);
+	nr_cells = size / sizeof(u32);
+	if (nr_cells < 4)
+		return -EINVAL;
 
 	map = kzalloc(size, GFP_KERNEL);
 	if (!map)
 		return -ENOMEM;
 
-	of_property_read_u32_array(dev->of_node, "iommu-map", (u32 *)map,
-				   size / sizeof(u32));
+	of_property_read_u32_array(dev->of_node, "iommu-map", map, nr_cells);
+
+	/*
+	 * Each entry is <bdf phandle sid... length> with #iommu-cells SID
+	 * cells (the first one is the SID). Accept 1-cell entries pointing
+	 * at a 2-cell SMMU like of_map_id() does.
+	 */
+	smmu = of_find_node_by_phandle(map[1]);
+	if (smmu) {
+		of_property_read_u32(smmu, "#iommu-cells", &cells);
+		of_node_put(smmu);
+	}
+	entry_len = 3 + cells;
+	if (cells == 2 && !(nr_cells % 4)) {
+		bool one_cell = true;
+
+		for (i = 0; i < nr_cells; i += 4)
+			if (map[i + 1] != map[1] || map[i + 3] != 1)
+				one_cell = false;
+		if (one_cell)
+			entry_len = 4;
+	}
+
+	if (nr_cells % entry_len) {
+		dev_err(dev, "Invalid iommu-map length\n");
+		kfree(map);
+		return -EINVAL;
+	}
+	nr_map = nr_cells / entry_len;
 
-	nr_map = size / (sizeof(*map));
+	/* Enable BDF to SID translation by disabling bypass mode (default) */
+	val = readl(pcie->parf + PARF_BDF_TO_SID_CFG);
+	val &= ~BDF_TO_SID_BYPASS;
+	writel(val, pcie->parf + PARF_BDF_TO_SID_CFG);
 
 	crc8_populate_msb(qcom_pcie_crc8_table, QCOM_PCIE_CRC8_POLYNOMIAL);
 
@@ -1157,11 +1182,13 @@ static int qcom_pcie_config_sid_1_9_0(struct qcom_pcie *pcie)
 	memset_io(bdf_to_sid_base, 0, CRC8_TABLE_SIZE * sizeof(u32));
 
 	/* Extract the SMMU SID base from the first entry of iommu-map */
-	smmu_sid_base = map[0].smmu_sid;
+	smmu_sid_base = map[2];
 
 	/* Look for an available entry to hold the mapping */
 	for (i = 0; i < nr_map; i++) {
-		__be16 bdf_be = cpu_to_be16(map[i].bdf);
+		u32 bdf = map[i * entry_len];
+		u32 smmu_sid = map[i * entry_len + 2];
+		__be16 bdf_be = cpu_to_be16(bdf);
 		u32 val;
 		u8 hash;
 
@@ -1184,7 +1211,7 @@ static int qcom_pcie_config_sid_1_9_0(struct qcom_pcie *pcie)
 		}
 
 		/* BDF [31:16] | SID [15:8] | NEXT [7:0] */
-		val = map[i].bdf << 16 | (map[i].smmu_sid - smmu_sid_base) << 8 | 0;
+		val = bdf << 16 | (smmu_sid - smmu_sid_base) << 8 | 0;
 		writel(val, bdf_to_sid_base + hash * sizeof(u32));
 	}
 
-- 
2.43.0

